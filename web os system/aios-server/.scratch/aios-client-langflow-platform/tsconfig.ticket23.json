{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": false,
    "noEmit": true
  },
  "include": [
    "tests/t02-langflow-sandbox.test.ts",
    "tests/t03-adapter-contract.test.ts",
    "tests/t03-url-timeout-negative.test.ts",
    "tests/t17-production-isolation.test.ts",
    "tests/t20-poc-01-complaint.test.ts",
    "tests/t20-poc-02-quotation.test.ts",
    "tests/t20-poc-03-refund.test.ts",
    "tests/t20-poc-06-outage.test.ts",
    "tests/t20-poc-07-digest-drift.test.ts",
    "tests/t20-poc-08-same-family.test.ts",
    "tests/t20-poc-09-budget.test.ts",
    "tests/t23-langflow-api-auth.test.ts",
    "tests/t24-runtime-binding-execution.test.ts",
    "tests/t25-langflow-runtime-boundary.test.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
