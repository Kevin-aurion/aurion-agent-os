# aios-mcp environment (copy to .env — .env is gitignored, never commit it)

# Base URL of the local aios-server (loopback only)
AIOS_MCP_BASE_URL=http://127.0.0.1:8700

# Dedicated AIOS account for the MCP server. For local Agent Builder use,
# `npm run provision:local-user` creates/rotates a least-privilege MEMBER.
AIOS_MCP_EMAIL=
AIOS_MCP_PASSWORD=

# `client` string sent to /api/auth/login and /api/auth/refresh (identifies this session in the Session table)
AIOS_MCP_CLIENT_NAME=mcp

# full exposes all AIOS provider tools; builder exposes only the nine inert
# Agent Builder tools/resources. Use builder for customer-facing Claude/Cursor.
AIOS_MCP_PROFILE=full

# Where the single-use refresh token is persisted (session.json, mode 0600)
AIOS_MCP_STATE_DIR=~/.aios-mcp

# Transport: stdio (default — Claude Desktop / Claude Code / Codex CLI spawn the process)
# or http (streamable-HTTP for a cloud co-worker; loopback-bound, tunnel it yourself e.g. via ngrok)
AIOS_MCP_TRANSPORT=stdio

# Only used when AIOS_MCP_TRANSPORT=http
AIOS_MCP_HTTP_PORT=8701
# Required when AIOS_MCP_TRANSPORT=http: every request must carry `x-aios-mcp-secret: <this value>`
AIOS_MCP_HTTP_SECRET=

# One-shot flag: set to 1 to revoke the persisted refresh token (calls /api/auth/logout) and exit.
# AIOS_MCP_LOGOUT=1
