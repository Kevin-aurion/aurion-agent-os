# ============================================================================
# AIOS — local-first agent OS. Copy to `.env` and fill the blanks.
# Nothing here leaves your machine except the direct, user-authorized API calls
# to Microsoft Graph, Google APIs, and the LINE push endpoint.
# ============================================================================

# ── Core ────────────────────────────────────────────────────────────────────
AIOS_ENCRYPTION_KEY=            # 32-byte hex. Generate: openssl rand -hex 32
AIOS_JWT_SECRET=                # Generate: openssl rand -hex 32
AIOS_HTTP_PORT=8700
AIOS_WEB_PORT=3100
AIOS_WEB_ORIGIN=http://localhost:3100
DATABASE_URL=postgresql://aios:aios@127.0.0.1:5433/aios
REDIS_URL=redis://127.0.0.1:6380
AIOS_DATA_DIR=/Users/kevin/Documents/lazyoffice/aios-data
AIOS_TZ=Asia/Taipei

# ── Microsoft 365 (Azure App Registration — https://portal.azure.com) ────────
# Register an app → Authentication → add redirect URI (Web) matching below.
# API permissions (delegated): offline_access User.Read Files.Read.All Mail.Read Mail.Send
MS_CLIENT_ID=
MS_TENANT_ID=common             # or your tenant GUID for single-tenant
MS_CLIENT_SECRET=               # optional; leave empty to use public-client + PKCE
MS_REDIRECT_URI=http://localhost:8700/api/integrations/microsoft/callback

# ── Google (GCP → APIs & Services → Credentials → OAuth client, "Web application")
# Scopes: drive.readonly gmail.readonly gmail.send
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8700/api/integrations/google/callback

# ── LINE Messaging API (https://developers.line.biz) ─────────────────────────
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_WEBHOOK_SECRET=            # shared secret guarding inbound webhook path
LINE_WEBHOOK_TUNNEL=            # optional public tunnel URL for inbound messages

# ── Engines (host CLIs) ──────────────────────────────────────────────────────
CLAUDE_CLI_PATH=/Users/kevin/.local/bin/claude
CODEX_CLI_PATH=/Users/kevin/.local/bin/codex

# ── Grok CLI（xAI）：技能建置與快速驗證引擎 ─────────────
GROK_CLI_PATH=/Users/kevin/.grok/bin/grok

# ── Memory (Phase 1: L1 wiki + L3 Qdrant semantic index) ─────────────────────
# Wiki markdown under MyAgent/<dept>/<slug>/memory/wiki/ is the source of truth.
# Qdrant holds rebuildable embeddings only. MEMORY_ENABLED=false → all memory I/O no-op.
MEMORY_ENABLED=true
QDRANT_URL=http://127.0.0.1:6333
EMBEDDING_PROVIDER=openrouter
# OpenRouter Gemini embedding (model id confirmed on openrouter.ai; default dim 3072).
# Fallback: set EMBEDDING_PROVIDER=google + GEMINI_API_KEY to call Google directly.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=google/gemini-embedding-001
# Optional: override vector size (google/gemini-embedding-001 default = 3072; also supports 768/1536).
# EMBEDDING_DIMENSION=3072
# GEMINI_API_KEY=                 # only if EMBEDDING_PROVIDER=google (direct Google fallback)

# ── AI knowledge pilot (read-only source + Langflow Sandbox) ────────────────
# The knowledge vault remains the source of truth. Langflow receives only the
# already-grounded and redacted answer envelope; it never receives vault access.
AIOS_KNOWLEDGE_VAULT_ROOT=/Users/kevin/Desktop/LazyOffice/AI知識庫
AIOS_KNOWLEDGE_PYTHON_PATH=/usr/bin/python3
AIOS_KNOWLEDGE_LANGFLOW_ID=4ec97062-f088-45b6-a304-a4fe1d1c9f26
