{
  "name": "aios-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AIOS local-first agent orchestration server (API + WebSocket hub + engine + scheduler)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --target node22 --clean",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "seed": "tsx src/scripts/seed.ts",
    "doctor": "tsx src/scripts/doctor.ts",
    "typecheck": "tsc --noEmit",
    "temporal:worker": "tsx src/temporal/worker.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@azure/msal-node": "^2.16.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@googleapis/drive": "^8.14.0",
    "@googleapis/gmail": "^7.0.0",
    "@prisma/client": "^5.22.0",
    "@qdrant/js-client-rest": "^1.18.0",
    "@temporalio/activity": "^1.20.3",
    "@temporalio/client": "^1.20.3",
    "@temporalio/worker": "^1.20.3",
    "@temporalio/workflow": "^1.20.3",
    "argon2": "^0.41.1",
    "bullmq": "^5.28.1",
    "cron-parser": "^4.9.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "google-auth-library": "^9.15.0",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "ulid": "^2.3.0",
    "ws": "^8.18.0",
    "xlsx": "^0.18.5",
    "yaml": "^2.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13",
    "prisma": "^5.22.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
