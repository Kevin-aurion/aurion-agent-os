{
  "description": "Initialize Aurion AIOS Agent-building lifecycle state on session start without storing OAuth credentials.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/lifecycle-hook.mjs"
            ],
            "timeout": 5,
            "statusMessage": "Initializing Aurion AIOS lifecycle"
          }
        ]
      }
    ]
  }
}
